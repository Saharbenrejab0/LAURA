/**
 * LAURA — Design tokens (Through the Lens palette)
 *
 * Optical-black + lens accent direction:
 *   - Canvas stays ivory and calm
 *   - Structural elements (NavHeader, sidebar active state) use ink/graphite
 *   - Action primary stays deep green (#1E3A34), used sparingly
 *   - Laura intelligence uses lens-blue (#8FB8C8) instead of generic AI blue
 *
 * Backward-compatible: all existing color.* paths still resolve.
 */

export const color = {
  bg: {
    canvas:  '#F7F5F0',
    surface: '#FFFFFF',
    warm:    '#FBFAF7',   // row hover, raised cards
    subtle:  '#F0EEE8',
    tint:    '#EAF1EE',   // legacy alias for action.primaryTint, kept
    lensMist:'#E8F1F3',   // Laura backgrounds
  },
  border: {
    soft:   '#E3DED5',
    strong: '#C9C1B4',
  },
  text: {
    primary:   '#161412',
    secondary: '#6F675E',
    tertiary:  '#9B9287',
    onPrimary: '#FFFFFF',
    onInk:     '#FBFAF7',  // text on optical-black surfaces
  },
  ink:     '#0B0B0A',     // optical black — structural
  graphite:'#2A2926',     // hover state of ink elements
  action: {
    primary:      '#1E3A34',
    primaryHover: '#162D28',
    primaryTint:  '#EAF1EE',
    ink:          '#0B0B0A',   // alternate primary for structural surfaces
    inkHover:     '#2A2926',
  },
  lens: {
    blue: '#8FB8C8',       // Laura accent (replaces generic AI blue)
    mist: '#E8F1F3',       // Laura background
    iris: '#6E8F7A',       // intermediate state
  },
  accent: {
    gold: '#B7894B',
    blue: '#315C8C',       // legacy info, kept
  },
  status: {
    success:  '#2F6B4F',
    warning:  '#B26A20',
    danger:   '#A33A32',
    dangerBg: '#FFF8F7',
  },
} as const;

