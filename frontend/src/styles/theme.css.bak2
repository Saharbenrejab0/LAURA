/* ────────────────────────────────────────────────────────────────
 * LAURA — Theme variables
 * Black & White luxe + Champagne accents.
 * Dark mode = true invert (toggle .dark on <html>).
 * ──────────────────────────────────────────────────────────────── */

:root {
  /* Surfaces */
  --laura-bg-canvas:        #FFFFFF;
  --laura-bg-surface:       #FFFFFF;
  --laura-bg-warm:          #F7F7F5;
  --laura-bg-subtle:        #FCFCFB;
  --laura-bg-tint:          #FAF5EA;
  --laura-bg-laura-mist:    #FAF5EA;
  --laura-bg-elevated:      #FFFFFF;

  /* Text */
  --laura-text-primary:     #0A0A0A;
  --laura-text-secondary:   #5A554F;
  --laura-text-tertiary:    #8E8780;
  --laura-text-on-primary:  #FAFAF7;

  /* Borders */
  --laura-border-soft:      #ECEAE5;
  --laura-border-strong:    #D4D0C8;

  /* Action (was green, now black) */
  --laura-action:           #0A0A0A;
  --laura-action-hover:     #1F1F1F;

  /* Champagne accents (stay the same on both themes) */
  --laura-champagne:        #C9A678;
  --laura-champagne-deep:   #8A6A3F;
  --laura-champagne-mist:   #FAF5EA;
  --laura-champagne-border: #E8D9B8;

  /* Semi-semantic statuses */
  --laura-success:          #8A6A3F;
  --laura-success-bg:       #FAF5EA;
  --laura-success-border:   #E8D9B8;
  --laura-warning:          #B26A20;
  --laura-warning-bg:       #FFF8F0;
  --laura-warning-border:   #E8D0B2;
  --laura-danger:           #8A2E27;
  --laura-danger-bg:        #FFF1EF;
  --laura-danger-border:    #E6C1BD;
  --laura-info:             #3F3A33;
  --laura-info-bg:          #EFECE7;
  --laura-info-border:      #D9D2C8;

  /* Legacy (some old CSS used these names) */
  --bg-base:                #FFFFFF;
  --bg-surface:             #FFFFFF;
  --bg-elevated:            #F8F7F4;
  --text-primary:           #0A0A0A;
  --text-secondary:         #5A554F;
  --text-muted:             #8E8780;
  --border:                 #E3DED5;
}

:root.dark {
  --laura-bg-canvas:        #000000;
  --laura-bg-surface:       #0A0A0A;
  --laura-bg-warm:          #141414;
  --laura-bg-subtle:        #0A0A0A;
  --laura-bg-tint:          #2A2620;
  --laura-bg-laura-mist:    #2A2620;
  --laura-bg-elevated:      #141414;

  --laura-text-primary:     #FAFAF7;
  --laura-text-secondary:   #A8A199;
  --laura-text-tertiary:    #6B665F;
  --laura-text-on-primary:  #0A0A0A;

  --laura-border-soft:      #1F1F1F;
  --laura-border-strong:    #2F2F2F;

  --laura-action:           #FAFAF7;
  --laura-action-hover:     #E0E0E0;

  --laura-champagne:        #C9A678;
  --laura-champagne-deep:   #C9A678;
  --laura-champagne-mist:   #2A2620;
  --laura-champagne-border: #4A3F2A;

  --laura-success:          #C9A678;
  --laura-success-bg:       #2A2620;
  --laura-success-border:   #4A3F2A;
  --laura-warning:          #D89740;
  --laura-warning-bg:       #2A1F12;
  --laura-warning-border:   #4A3520;
  --laura-danger:           #C77A75;
  --laura-danger-bg:        #2A1818;
  --laura-danger-border:    #4A2A26;
  --laura-info:             #C0BAB1;
  --laura-info-bg:          #1F1F1F;
  --laura-info-border:      #2A2A2A;

  /* Legacy */
  --bg-base:                #0A0A0A;
  --bg-surface:             #141414;
  --bg-elevated:            #1A1A1A;
  --text-primary:           #FAFAF7;
  --text-secondary:         #A8A199;
  --text-muted:             #6B665F;
  --border:                 #2A2A2A;
}

/* Smooth theme transitions */
html {
  transition: background-color 160ms cubic-bezier(0.2, 0, 0, 1);
}
body {
  background: var(--laura-bg-canvas);
  color: var(--laura-text-primary);
  transition: background-color 160ms cubic-bezier(0.2, 0, 0, 1), color 160ms cubic-bezier(0.2, 0, 0, 1);
}
