'use client';

/**
 * ApprovalPanel - the approval workflow visualization.
 *
 * Renders the 7-step workflow as a horizontal timeline with the current
 * status highlighted. Shows Approve / Reject action buttons when the
 * current user has the `validate` permission on this LOA.
 *
 * Used in the draft page right under the header.
 */

import { useState } from 'react';
import api from '@/lib/api';
import StatusBadge from '@/components/StatusBadge';
import { color, font, radius, space } from '@/styles/tokens';

interface LOAData {
  id: string;
  status: string;
}

interface Permissions {
  can_validate: boolean;
  user_role: string;
}

interface Props {
  loa: LOAData;
  perms: Permissions;
  onActionDone: () => void;
}

const WORKFLOW_STEPS = [
  { key: 'draft',                    label: 'Draft',              actor: 'Requestor' },
  { key: 'emea_review',              label: 'EMEA review',        actor: 'EMEA team' },
  { key: 'global_brand_review',      label: 'Brand review',       actor: 'Global Brands' },
  { key: 'emea_brand_rework',        label: 'EMEA rework',        actor: 'EMEA team' },
  { key: 'global_functions_review',  label: 'Functions review',   actor: 'Global Functions' },
  { key: 'emea_functions_rework',    label: 'EMEA check',         actor: 'EMEA team' },
  { key: 'cmo_cfo_review',           label: 'CMO / CFO',          actor: 'CMO and CFO' },
  { key: 'emea_cmo_rework',         label: 'EMEA review',        actor: 'EMEA team' },
  { key: 'corporate_review',         label: 'Corporate',          actor: 'Corporate team' },
  { key: 'approved',                 label: 'Approved',           actor: 'Final' },
];

function normalizeStatus(s: string): string {
  return (s || '').toLowerCase().replace(/[\s/-]+/g, '_').replace(/_+/g, '_').trim();
}

export default function ApprovalPanel({ loa, perms, onActionDone }: Props) {
  const [busy, setBusy] = useState<null | 'approve' | 'reject'>(null);
  const [error, setError] = useState<string | null>(null);

  const currentStatus = normalizeStatus(loa.status);
  const currentIndex = WORKFLOW_STEPS.findIndex(s => s.key === currentStatus);
  const isRejected = currentStatus === 'rejected';
  const isApproved = currentStatus === 'approved';
  const isDraft = currentStatus === 'draft';
  const canAct = perms.can_validate && !isRejected && !isApproved && !isDraft;

  const performAction = async (action: 'approve' | 'reject') => {
    setBusy(action); setError(null);
    try {
      await api.post(`/loa/${loa.id}/${action}`);
      onActionDone();
    } catch (e: any) {
      setError(e?.response?.data?.detail || e?.message || `${action} failed`);
    } finally {
      setBusy(null);
    }
  };

  return (
    <section style={{
      background: color.bg.surface,
      border: `1px solid ${color.border.soft}`,
      borderRadius: radius.card,
      padding: space[5],
      marginBottom: space[4],
    }}>
      <header style={{
        display: 'flex', alignItems: 'center', justifyContent: 'space-between',
        marginBottom: space[5], gap: space[3], flexWrap: 'wrap',
      }}>
        <div>
          <p style={{
            margin: 0, fontSize: 11, letterSpacing: '0.04em',
            textTransform: 'uppercase', fontWeight: 500, color: color.text.tertiary,
          }}>Approval workflow</p>
          <div style={{ marginTop: space[2], display: 'flex', alignItems: 'center', gap: space[2] }}>
            <StatusBadge status={loa.status} />
            {currentIndex >= 0 && (
              <span style={{
                fontSize: 12, color: color.text.secondary,
              }}>
                · {isApproved ? 'Final' : isDraft ? `${WORKFLOW_STEPS[currentIndex].actor} is preparing` : `Awaiting ${WORKFLOW_STEPS[currentIndex].actor}`}
              </span>
            )}
          </div>
        </div>

        {canAct && (
          <div style={{ display: 'flex', gap: space[2] }}>
            <button onClick={() => performAction('reject')} disabled={!!busy} style={rejectButtonStyle(busy === 'reject')}>
              {busy === 'reject' ? 'Rejecting…' : 'Request changes'}
            </button>
            <button onClick={() => performAction('approve')} disabled={!!busy} style={approveButtonStyle(busy === 'approve')}>
              {busy === 'approve' ? 'Approving…' : 'Approve'}
            </button>
          </div>
        )}

        {!canAct && !isApproved && !isDraft && (
          <span style={{
            fontSize: 12, color: color.text.tertiary, fontStyle: 'italic',
          }}>
            You have view access only at this step
          </span>
        )}
      </header>

      {error && (
        <div style={{
          padding: space[2], marginBottom: space[3],
          background: color.status.dangerBg, color: color.status.danger,
          borderRadius: radius.field, fontSize: 12, border: '1px solid #E6C1BD',
        }}>{error}</div>
      )}

      {/* Horizontal timeline */}
      <div style={{
        display: 'flex', alignItems: 'flex-start',
        justifyContent: 'space-between', gap: 0, paddingTop: space[2],
      }}>
        {WORKFLOW_STEPS.map((step, i) => {
          const isDone = !isRejected && (i < currentIndex || isApproved);
          const isCurrent = !isRejected && !isApproved && i === currentIndex;
          const dotBg = isDone || isCurrent ? color.action.primary : color.bg.surface;
          const dotBorder = isDone || isCurrent ? color.action.primary : color.border.strong;
          const lineBg = isDone ? color.action.primary : color.border.soft;
          return (
            <div key={step.key} style={{
              flex: 1, display: 'flex', flexDirection: 'column',
              alignItems: 'center', position: 'relative', minWidth: 0,
            }}>
              {i > 0 && (
                <div style={{
                  position: 'absolute', top: 11, left: '-50%', right: '50%',
                  height: 2, background: lineBg,
                }} />
              )}
              <div style={{
                width: 22, height: 22, borderRadius: 999,
                background: dotBg,
                border: `2px solid ${dotBorder}`,
                position: 'relative', zIndex: 1,
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                color: 'white', fontSize: 11, fontWeight: 600,
                boxShadow: isCurrent ? `0 0 0 4px ${color.bg.tint}` : 'none',
              }}>
                {isDone && !isCurrent ? '✓' : ''}
              </div>
              <p style={{
                margin: `${space[2]}px 0 0`, fontSize: 11, lineHeight: '14px',
                color: isCurrent ? color.text.primary : isDone ? color.text.secondary : color.text.tertiary,
                fontWeight: isCurrent ? 600 : 400,
                textAlign: 'center', maxWidth: 80,
                fontFamily: font.sans,
              }}>{step.label}</p>
            </div>
          );
        })}
      </div>

      {isRejected && (
        <div style={{
          marginTop: space[4], padding: space[3],
          background: '#FFF1EF', color: color.status.danger,
          borderRadius: radius.field, fontSize: 13,
          border: '1px solid #E6C1BD',
        }}>
          This LOA was rejected. Address the feedback and resubmit to restart the workflow.
        </div>
      )}

      {isApproved && (
        <div style={{
          marginTop: space[4], padding: space[3],
          background: '#EAF1EE', color: color.status.success,
          borderRadius: radius.field, fontSize: 13,
          border: '1px solid #CFE0D7',
        }}>
          Approved. This LOA is final and locked.
        </div>
      )}
    </section>
  );
}

function approveButtonStyle(busy: boolean): React.CSSProperties {
  return {
    background: busy ? color.border.strong : color.action.primary,
    color: color.text.onPrimary, border: 'none', borderRadius: radius.field,
    padding: '8px 16px', fontSize: 13, fontWeight: 600,
    fontFamily: font.sans, cursor: busy ? 'not-allowed' : 'pointer',
  };
}

function rejectButtonStyle(busy: boolean): React.CSSProperties {
  return {
    background: 'transparent',
    color: color.status.danger,
    border: `1px solid ${color.status.danger}`,
    borderRadius: radius.field,
    padding: '8px 16px', fontSize: 13, fontWeight: 500,
    fontFamily: font.sans, cursor: busy ? 'not-allowed' : 'pointer',
  };
}
