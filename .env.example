# ============================================================
# LAURA — environment variables template
# Copy this file to .env and fill in real values
# NEVER commit .env — it is in .gitignore
# ============================================================

# --- Claude API (get from manager) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Database ---
DATABASE_URL=postgresql://laura_user:PASSWORD@localhost:5432/laura_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=generate-a-strong-random-string-here
JWT_EXPIRY_HOURS=8

# --- File storage (EssilorLuxottica Azure / AWS) ---
# Leave empty during local dev — files saved locally instead
AZURE_STORAGE_CONNECTION_STRING=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-west-1

# --- n8n webhook ---
N8N_WEBHOOK_URL=https://aitomarket.app.n8n.cloud/webhook/laura
N8N_API_KEY=

# --- App config ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://laura.vercel.app
LOG_LEVEL=INFO

# --- AI config ---
# Model to use for LOA suggestions
CLAUDE_MODEL=claude-sonnet-4-20250514
# Max tokens for suggestions (keep low = fast + cheap)
CLAUDE_MAX_TOKENS=500
# Anonymise data before sending to Claude (required by EL security policy)
ANONYMISE_BEFORE_LLM=true
